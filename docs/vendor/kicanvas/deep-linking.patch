+            await new Promise<void>((resolve) =>
+                requestAnimationFrame(() => resolve()),
+            );
+        }
+        if (this.loading || !this.#schematic_app) {
+            throw new Error("KiCanvas schematic viewer did not initialize");
+        }
+        await this.#schematic_app.viewerReady;
+
+        const page = this.#project.page_by_name(filename);
+        if (!page || page.type !== "schematic") {
+            throw new Error(`Unable to find schematic ${filename}`);
+        }
+
+        const viewer = this.#schematic_app.viewer as SchematicViewer;
+        await viewer.loaded;
+        const waitForPage = (target: typeof page) =>
+            new Promise<void>((resolve, reject) => {
+                const timeout = window.setTimeout(() => {
+                    viewer.removeEventListener(
+                        KiCanvasLoadEvent.type,
+                        loaded,
+                    );
+                    reject(
+                        new Error(`Schematic ${target.filename} did not load`),
+                    );
+                }, 15000);
+                const loaded = () => {
+                    if (viewer.document !== target.document) {
+                        return;
+                    }
+                    window.clearTimeout(timeout);
+                    viewer.removeEventListener(KiCanvasLoadEvent.type, loaded);
+                    resolve();
+                };
+                viewer.addEventListener(KiCanvasLoadEvent.type, loaded);
+            });
+
+        if (this.#project.active_page !== page) {
+            const loaded = waitForPage(page);
+            this.#project.set_active_page(page);
+            await loaded;
+        } else if (viewer.document !== page.document) {
+            await waitForPage(page);
+        }
+
+        viewer.select(null);
+        const symbol = viewer.schematic.find_symbol(reference);
+        if (!symbol) {
+            throw new Error(
+                `Unable to find reference ${reference} in ${filename}`,
+            );
+        }
+        for (let attempt = 0; attempt < 120 && !viewer.selected; attempt++) {
+            const [bbox] = viewer.layers.query_item_bboxes(symbol);
+            if (bbox) {
+                viewer.select(bbox);
+                break;
+            }
+            await new Promise<void>((resolve) =>
+                requestAnimationFrame(() => resolve()),
+            );
+        }
+        if (!viewer.selected) {
+            const { x, y } = symbol.at.position;
+            viewer.select(new BBox(x - 5, y - 5, 10, 10, symbol));
+        }
+        if (!viewer.selected) {
+            throw new Error(
+                `Unable to find reference ${reference} in ${filename}`,
+            );
+        }
+        viewer.zoom_to_selection();
